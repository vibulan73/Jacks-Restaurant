# Jack's Norwood - Frontend Environment Variables
# Vite exposes variables prefixed with VITE_ to the browser

# Backend API base URL
# VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_BASE_URL=http://192.168.1.3:8080/api

# Restaurant Info (used in SEO / meta)
VITE_RESTAURANT_NAME=Jack's Norwood
VITE_RESTAURANT_PHONE=(08) 8234 5678
VITE_RESTAURANT_EMAIL=info@jacksnorwood.com.au
VITE_RESTAURANT_ADDRESS=123 The Parade, Norwood SA 5067

# Google Maps embed URL
# How to get it: Google Maps → search your location → Share → "Embed a map" → copy the src="..." value
VITE_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1518.3721008857515!2d-77.97850594846558!3d44.38610811655684!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cd4ab1763658ab7%3A0x4ee8b57611e70947!2sJacks%20Family%20Restaurant!5e0!3m2!1sen!2slk!4v1774326019891!5m2!1sen!2slk

# Hero section background image URL
# Leave empty to use the default bundled image (IMG_0327_denoiser.jpeg)
# To use an uploaded image, set to its /uploads/... path, e.g:
#   VITE_HERO_IMAGE_URL=/uploads/abc123.jpeg